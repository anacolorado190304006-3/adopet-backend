# Local defaults only. Set NODE_ENV=production in App Service and supply all required values.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adopet
DB_USER=adopet
DB_PASSWORD=
# Production requires verified TLS; optional CA file must exist on the host.
DB_SSL=false
DB_SSL_CA_FILE=
AUTH0_AUDIENCE=https://api.example.invalid
AUTH0_ISSUER_BASE_URL=https://tenant.example.invalid/
AUTH0_DOMAIN=tenant.example.invalid
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_CONNECTION=
# NVD_API_KEY belongs in CI secrets, not in the runtime application.
